{
  "name": "credit-conveyor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:fonts": "node scripts/prepare-fonts.mjs",
    "predev": "npm run prepare:fonts",
    "dev": "vite",
    "prebuild": "npm run prepare:fonts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "download:fonts": "node scripts/prepare-fonts.mjs --download",
    "test:fonts": "node --test scripts/prepare-fonts.test.mjs",
    "test:wizard": "node --test scripts/new-application.test.cjs",
    "test:dashboard": "node --test scripts/dashboard.test.cjs"
  },
  "dependencies": {
    "@fontsource/onest": "5.3.1",
    "@fontsource/unbounded": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
