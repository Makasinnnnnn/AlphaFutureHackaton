# Скопируйте в .env и при необходимости измените. Все значения имеют безопасные значения по умолчанию для демо.

# --- База данных ---
POSTGRES_USER=conveyor
POSTGRES_PASSWORD=conveyor
POSTGRES_DB=conveyor

# --- Безопасность ---
# Обязательно смените для любого не-демо окружения (минимум 32 символа)
JWT_SECRET=change-me-in-production-please-32b
# production — отключает выдачу тестовых учёток через /api/auth/demo-accounts
ENVIRONMENT=demo

# --- Порты на хосте ---
WEB_PORT=8080
API_PORT=8000

# --- Конвейер ---
# Пауза между автоматическими этапами, чтобы движение заявки было видно в интерфейсе (в продакшене 0)
PIPELINE_STEP_DELAY_SEC=1.5

# --- Симулятор внешних источников ---
# Доля случайных отказов (0..1) — для проверки ретраев и отказоустойчивости
MOCK_FAILURE_RATE=0
MOCK_LATENCY_MS=150

# --- Опциональный ИИ-ассистент (open-weights модель через Ollama) ---
LLM_ENABLED=false
LLM_PROVIDER=ollama
# Для локального OpenAI-совместимого сервера: LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:1.5b

LOG_LEVEL=INFO
